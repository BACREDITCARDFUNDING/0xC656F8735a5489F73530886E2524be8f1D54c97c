@charset "utf-8";

.wrapper { margin: 0px auto -99px; min-height: 100%; height: auto !important; background-color: rgb(248, 249, 250) !important; }

#push { height: 99px; }

body.dark-mode .wrapper { background-color: rgb(19, 42, 71) !important; }

.ui-autocomplete { max-height: 300px; overflow: hidden auto; padding-bottom: 1px; z-index: 91199; }

body.dark-mode .ui-autocomplete { border-color: rgb(1, 53, 88); background-color: rgb(1, 38, 63) !important; }

.ui-autocomplete .left { float: left; }

.ui-autocomplete .right { float: right; }

.ui-autocomplete-category { padding: 5px 15px; margin: 0px; font-weight: bold; }

.jvectormap-container { width: 100%; height: 100%; }

.hd-doc-search__category { display: block; color: rgb(55, 125, 255); }

.ui-autocomplete-input.form-control:not(:last-child) { border-top-right-radius: 0.125rem; border-bottom-right-radius: 0.125rem; }

.anomaly { background: rgb(249, 249, 249) !important; }

body.dark-mode .anomaly { background: rgb(1, 44, 73) !important; }

tspan { text-decoration: none; text-shadow: none !important; }

body.dark-mode .highcharts-data-labels text { color: rgb(162, 185, 200) !important; fill: rgb(162, 185, 200) !important; }

body.dark-mode .u-ver-divider-left::before { border-color: rgb(1, 53, 88) !important; }

.u-ver-divider-left { position: relative; }

.u-ver-divider-left::before { position: absolute; top: 0px; left: 0px; height: 100%; border-right: 1px solid rgb(231, 234, 243); content: ""; }

@media (max-width: 575.98px) {
  .u-ver-divider-left--none-sm::after { display: none; }
}

@media (max-width: 767.98px) {
  .u-ver-divider-left--none-md::after { display: none; }
}

@media (max-width: 991.98px) {
  .u-ver-divider-left--none-lg::after { display: none; }
}

.u-label-inline { display: inline !important; }

.mn-3 { margin-top: -3px; margin-bottom: -3px; }

.mn-b3 { margin-bottom: -3px; }

.wordwrap { white-space: pre-wrap; overflow-wrap: break-word; }

a.address-tag { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; }

@media (max-width: 760px) {
  .dropdown-menu-sm-right { right: 0px; left: 0px !important; }
}

.btn-secondary:not(:disabled):not(.disabled).active, .btn-secondary:not(:disabled):not(.disabled):active, .show > .btn-secondary.dropdown-toggle { color: rgb(255, 255, 255) !important; border-color: rgb(95, 106, 116) !important; background-color: rgb(95, 106, 116) !important; }

.bg-light.text-white { color: rgb(48, 49, 50) !important; }

.bg-info.text-white a { color: rgb(17, 59, 122) !important; }

.bg-warning.text-white a { color: rgb(34, 99, 143) !important; }

.bg-danger.text-white a { color: rgb(55, 77, 100) !important; }

.bg-success.text-white a { color: rgb(55, 108, 145) !important; }

.bg-secondary.text-white a { color: rgb(30, 86, 124) !important; }

.bg-primary.text-white a { color: rgb(8, 84, 135) !important; }

.custom-datatables-processing > div.dataTables_processing { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background: transparent; top: 0px !important; }
